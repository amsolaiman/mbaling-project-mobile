    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-hook-form": "^7.84.0",
    "react-native": "0.86.3",
    "react-native-actions-sheet": "^10.1.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
