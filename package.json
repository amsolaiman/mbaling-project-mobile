    "@typescript-eslint/parser": "^8.14.0",
    "babel-preset-expo": "^57.0.10",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-unused-imports": "^4.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "madge": "^8.0.0",
    "prettier": "^3.8.4",
    "standard-version": "^9.5.0",
    "tsx": "^4.22.4",
